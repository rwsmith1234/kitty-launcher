<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: blue-sky gradient + Kitty -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="108dp" android:height="108dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#1E3A5F"
                android:centerColor="#3E78AE"
                android:endColor="#9BD0F0" />
        </shape>
    </item>
    <item
        android:width="100dp"
        android:height="100dp"
        android:gravity="center"
        android:drawable="@drawable/ic_kitty" />
</layer-list>
